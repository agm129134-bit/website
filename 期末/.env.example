# 複製成 .env 後填入自己的值（.env 不會進 git，也不會被網站公開）
# 本機 node server.js 會自動讀取 .env；docker compose 也會讀同一份檔案

# 服務埠號（預設 8090）
PORT=8090

# 第一次啟動、帳號資料庫是空的時候建立的 jyun 帳號初始密碼
# 留空會隨機產生，並只印在伺服器 log 一次
DEFAULT_ADMIN_PASSWORD=

# 彈彈play 開放平台 (彈幕)：https://www.dandanplay.com/
DANDANPLAY_APP_ID=
DANDANPLAY_APP_SECRET=

# 拷貝漫畫登入 token（選填）
COPYMANGA_TOKEN=
