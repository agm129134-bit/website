# 複製成 .env 後填入自己的值（.env 不會進 git，也不會被網站公開）
# 本機 node server.js 會自動讀取 .env；docker compose 也會讀同一份檔案

# 服務埠號（預設 8090）
PORT=8090

# 第一次啟動、帳號資料庫是空的時候建立的 demo 示範帳號初始密碼
# 留空會隨機產生，並只印在伺服器 log 一次
DEFAULT_ADMIN_PASSWORD=

# 擁有者帳號（私用 Docker 填自己的帳號；展示用的本機 node server.js 保持留空）
# 由 docker-compose.yml 映射為容器內的 OWNER_USER 環境變數
# 只有這個帳號能使用網頁上的 Docker 管理功能；留空時 Docker 管理 API 直接停用
DOCKER_OWNER_USER=

# 是否開放登入頁「忘記密碼」直接改成新密碼（沒有 Email 驗證，開放後任何人都能改掉別人的密碼）
# 預設關閉；只建議在信任的私人環境暫時設為 true 救急，用完改回來
ALLOW_PASSWORD_RESET=

# 彈彈play 開放平台 (彈幕)：https://www.dandanplay.com/
DANDANPLAY_APP_ID=
DANDANPLAY_APP_SECRET=

# 拷貝漫畫登入 token（選填）
COPYMANGA_TOKEN=
